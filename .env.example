# Videl local development template. Never commit real credentials.
# Production: configure bot/database secrets in Render and WEBAPP_SECRET on both Render + Vercel.

# Telegram bot and owner
API_ID=
API_HASH=
BOT_TOKEN=
BOT_USERNAME=Videl0Bot
# Text command prefixes: slash plus common punctuation. Telegram's command menu remains slash-only.
COMMAND_PREFIXES=/!?&.#~$+
OWNER_ID=6265999542
STRING_SESSION=
SESSION_NAME=Videl0
LOGGER_ID=

# MongoDB is the only application database
MONGO_DB_URL=
MONGO_DB_NAME=Videl

# Split deployment: Render runs this bot/API; Vercel serves the Next.js frontend
PORT=10000
WEBAPP_URL=https://videl-studio.vercel.app
WEBAPP_SECRET=generate-a-long-random-shared-secret-and-set-the-same-value-on-render-and-vercel

# Optional Eldian Network music API (provide a trusted deployment and its API key)
ELDIAN_API_URL=
ELDIAN_API_KEY=

# Optional ShizuMusic-compatible downloader (Shruti API; direct media endpoint)
# Current base URL; the old .site host is being discontinued.
# GET {YT_API_URL}/download?url=VIDEO_ID&type=audio|video&api_key=YT_API_KEY
YT_API_URL=https://api.shrutibots.in
YT_API_KEY=

# Optional media/service settings
YT_COOKIES_FILE=cookies.txt
DOWNLOAD_DIR=downloads
MAX_DURATION_SECONDS=1800
QUEUE_LIMIT=20
# Quality-first Telegram voice chat output: studio=96 kbps stereo; lower presets can help weak links.
VOICE_AUDIO_QUALITY=studio
ENV=production

# Telegram custom emoji and keyboard theme. IDs are already configured in premium_emojis.py.
# Rendering still requires Telegram eligibility (for example, a Premium bot owner
# for supported messages, or a Fragment additional username). Rejected visuals fall back.
# Telegram renders custom emoji in private/group chats only when the bot owner has Premium.
# Otherwise the bot falls back to the regular Unicode emoji.
USE_PREMIUM_EMOJI=1
USE_PREMIUM_BUTTON_ICONS=1
