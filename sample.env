# Videl local development template. Never commit real credentials.
# Production: configure bot/database secrets in Render and WEBAPP_SECRET on both Render + Vercel.

# Telegram bot and owner
API_ID=
API_HASH=
BOT_TOKEN=
BOT_USERNAME=videlapp
# Required owner Telegram ID — configure privately; never commit its value.
OWNER_ID=
STRING_SESSION=
SESSION_NAME=Videl0
LOGGER_ID=

# MongoDB is the only application database
MONGO_DB_URL=
MONGO_DB_NAME=Videl

# Split deployment: Render runs this bot/API; Vercel serves the Next.js frontend
PORT=10000
WEBAPP_URL=https://videl-studio.vercel.app
# Required: generate a strong random value and set the same private value on Render and Vercel.
WEBAPP_SECRET=

# Optional Eldian Network music API (provide a trusted deployment and its API key)
ELDIAN_API_URL=
ELDIAN_API_KEY=

# Optional Gemini assistant provider. AI guest replies are disabled unless configured.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional media/service settings
# Optional protected deployment mount; leave unset unless a private cookie jar is required.
YTDLP_COOKIES=
DOWNLOAD_DIR=downloads
MAX_DURATION_SECONDS=1800
QUEUE_LIMIT=20
VOICE_AUDIO_QUALITY=high
ENV=production
