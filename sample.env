# ════════════════════════════════════════════════════
#            Videl — Environment Variables
# ════════════════════════════════════════════════════

# ── REQUIRED ────────────────────────────────────────

# Telegram API Credentials
# Get from: https://my.telegram.org
API_ID=
API_HASH=

# Telegram Bot Token
# Get from: @BotFather
BOT_TOKEN=

# Pyrogram String Session
# Generate from your assistant account
STRING_SESSION=

# MongoDB Database URL
# Get free cluster from: https://cloud.mongodb.com
MONGO_DB_URL=

# Your Telegram User ID
OWNER_ID=

# Logger Group / Channel ID
LOGGER_ID=

# ── BOT SETTINGS ────────────────────────────────────

BOT_NAME=
BOT_LINK=

UPDATES_CHANNEL=
SUPPORT_GROUP=

# ── MEDIA ───────────────────────────────────────────

START_PHOTOS=https://iili.io/n5ClDil.jpg
PING_IMG_URL=https://files.catbox.moe/ddzvc0.jpg

# ── SYSTEM ──────────────────────────────────────────

SESSION_NAME=videl
PORT=10000

# ── LIMITS ──────────────────────────────────────────

MAX_DURATION_SECONDS=1800
QUEUE_LIMIT=20
COOLDOWN=10

# Optional: YouTube cookies (fixes bot-check on Render/Railway)
# Export from browser (Chrome extension 'Get cookies.txt LOCALLY'), upload as cookies.txt
YTDLP_COOKIES=
MONGO_DB_NAME=Videl

# Eldian Music API (primary YouTube download — fixes Render bot-check)
# Public: https://eldian-music-api-production.up.railway.app
# Official: https://github.com/Eldian-Network/eldian-music-api
ELDIAN_API_URL=https://eldian-music-api-production.up.railway.app
ELDIAN_API_KEY=

# YouTube cookies (REQUIRED on Render — bot-check blocks datacenter IPs)
# Export with Chrome extension "Get cookies.txt LOCALLY" while logged into YouTube
# Option A: upload cookies.txt to the service and set path:
YTDLP_COOKIES=/app/cookies.txt
# Option B: host the file anywhere public and set URL:
# YTDLP_COOKIES_URL=https://files.catbox.moe/xxxx.txt
# Optional private Eldian host (public Railway instance is offline):
# ELDIAN_API_URL=
# ELDIAN_API_KEY=

# Built-in download API (Eldian-compatible) runs on the same Render service:
#   GET  /api/status
#   GET  /api/stream_audio?url=https://youtube.com/watch?v=ID
#   GET  /api/download?url=...
#   POST /v1/track/by-video-id  + header X-API-Key (if ELDIAN_API_KEY set)
# Bot auto-uses http://127.0.0.1:$PORT — override only if you host Eldian separately:
# ELDIAN_API_URL=http://127.0.0.1:10000
# Still need YouTube cookies on Render for yt-dlp inside the API:
# YTDLP_COOKIES=/app/cookies.txt

# Auto proxy + cookies save
# PROXY_URL=http://user:pass@host:port
# PROXY_LIST=http://p1:8080,http://p2:8080
AUTO_PROXY=1
# Cookies auto-saved to downloads/cookies.txt when YTDLP_COOKIES_URL is set
# YTDLP_COOKIES_URL=https://files.catbox.moe/xxxx.txt
# YTDLP_COOKIES=/app/cookies.txt

# ── Download API (same as BadMusic / ShizuMusic) ──
# Open Telegram → @SHRUTIAPIBOT → get free API key
SHRUTI_API_URL=https://api.shrutibots.site
SHRUTI_API_KEY=
